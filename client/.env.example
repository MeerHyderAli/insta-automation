# Browser configuration for the Vite app. Copy to client/.env.local.
#
# Demo mode renders the product with clearly-labelled sample data and never
# calls Instagram or the API. Use it for UI review only. NEVER enable demo mode
# in a production build that real customers might mistake for live automation.
VITE_DEMO_MODE=true

# Base URL of the Express API. Leave empty to use the Vite dev proxy.
VITE_API_BASE_URL=

# Supabase browser client (safe to expose). Required when demo mode is off.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

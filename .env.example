# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# On your host (Vercel etc.) set the same variables in the dashboard.
# NEVER commit .env.local and NEVER prefix secrets with NEXT_PUBLIC_.

# ---------------------------------------------------------------------------
# Required for real DMs
# ---------------------------------------------------------------------------

# Long-lived Instagram access token for YOUR professional account.
# Generated in the Meta app dashboard (Instagram > API setup with Instagram
# login). Server-side only. Expires after ~60 days — refresh it, see README.
IG_ACCESS_TOKEN=

# App Secret from Meta app dashboard > Settings > Basic ("Show").
# Used to verify the X-Hub-Signature-256 header on every webhook POST.
META_APP_SECRET=

# Any long random string YOU invent. Paste the exact same value into the
# Meta webhook configuration as the "Verify token".
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-string

# First DM (private reply to the triggering comment), sent only after follow
# check #1 passes. It includes a quick-reply button. {username} = e.g.
# @alice, {keyword} = matched word.
INTRO_DM_MESSAGE=Thanks for commenting, {username}! Tap the button below to get your link.
GET_LINK_BUTTON_TEXT=Click to get link

# Final DM template, sent only after the user taps the button AND follow
# check #2 passes. {link} is replaced with the link for that Reel/post.
DM_MESSAGE=Here is your link: {link}

# Different link per Reel/post: normally add these in the dashboard's
# "Reel resources" section (saved in the database, no redeploy). This env
# JSON map is only an optional fallback; dashboard mappings override it.
# Example: {"17900000000000001":"https://example.com/reel-a","17900000000000002":"https://example.com/reel-b"}
MEDIA_LINKS_JSON={}

# Optional fallback for media without a dashboard/env entry above. Leave
# empty if an unmapped Reel must receive nothing rather than a default link.
DEFAULT_LINK_URL=https://example.com/your-resource

# Sent after a tap when follow check #2 says not following / unverified.
# Each includes a Try again button so the user can follow and re-check.
NOT_FOLLOWING_MESSAGE=You are not following this account yet. Please follow first, then tap Try again below to get your link.
FOLLOW_UNVERIFIED_MESSAGE=I could not verify your follow status yet. Please make sure you follow this account, then tap Try again below.
TRY_AGAIN_BUTTON_TEXT=Try again

# Public reply posted under the triggering comment. This is separate from
# the DM: if this public reply fails, the DM/link result is unchanged.
# Following = shown only after check #1 verifies following and the DM
# prompt is sent. Not following = shown when check #1 positively reports
# not following (no DM prompt). Unverified = shown after a comment-first
# prompt; it deliberately does not claim that the link was sent.
COMMENT_REPLY_ENABLED=true
COMMENT_REPLY_FOLLOWING_MESSAGE={username} check your DM 📩 Tap the button there to get your link.
COMMENT_REPLY_NOT_FOLLOWING_MESSAGE={username} please follow this account first, then comment again to get the link in your DM.
COMMENT_REPLY_UNVERIFIED_MESSAGE={username} check your DM 📩 Tap the button there and we’ll verify your follow before sending the link.

# Follow status is checked TWICE. Keep both true in production:
# #1 before the thanks prompt DM; #2 after the button tap, before the link.
REQUIRE_FOLLOW_BEFORE_PROMPT=true
REQUIRE_FOLLOW_FOR_LINK=true
# Comment-first mode: Meta cannot verify most commenters at check #1 until
# they have messaged the account (profile-consent error 230). Keep true to
# send the button prompt to those UNVERIFIED commenters anyway. A positive
# not-following result at #1 still blocks the prompt, and check #2 remains
# strict before any link is sent. Set false only for strict prompt gating.
PROMPT_UNVERIFIED_COMMENTERS=true
# Legacy deployments may instead set REQUIRE_FOLLOW_TO_SEND=true, which the
# app treats as the fallback value for both checks above.

# ---------------------------------------------------------------------------
# Matching
# ---------------------------------------------------------------------------

# keywords = only COMMENT_KEYWORDS trigger. any = every non-empty comment
# triggers (max one prompt/link flow per user per Reel/post).
COMMENT_MATCH_MODE=keywords

# Comma-separated, case-insensitive, whole-word matching (keywords mode).
# Put your keyword first, then common typos/variants. CHANGE THIS to yours.
COMMENT_KEYWORDS=link,links,lnik,likn,lnk,liink,linkk

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Your Instagram professional account id. If set, webhook events for any
# other account are ignored. The id is in the webhook entry.id and in the
# API setup page next to your account.
IG_ACCOUNT_ID=

# Pin the Graph API version. Check Meta's changelog before changing.
META_GRAPH_VERSION=v25.0

# true = match and record comments but do NOT call Instagram (local testing).
# Must be false in production for real DMs.
DRY_RUN=true

# Durable storage for processed comment ids. REQUIRED on serverless hosts
# such as Vercel (the local file store does not persist there). Any Postgres
# connection string works (Neon, Supabase, Vercel Postgres, Railway...).
DATABASE_URL=

# Local file store location (used only when DATABASE_URL is empty).
DATA_FILE=./data/comments.json

# Basic Auth for the dashboard page. Required in production to add/edit
# Reel resources from the dashboard (and recommended because the page shows
# commenter usernames and comment text).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# On your host (Vercel etc.) set the same variables in the dashboard.
# NEVER commit .env.local and NEVER prefix secrets with NEXT_PUBLIC_.

# ---------------------------------------------------------------------------
# Required for real DMs
# ---------------------------------------------------------------------------

# Long-lived Instagram access token for YOUR professional account.
# Generated in the Meta app dashboard (Instagram > API setup with Instagram
# login). Server-side only. Expires after ~60 days — refresh it, see README.
IG_ACCESS_TOKEN=

# App Secret from Meta app dashboard > Settings > Basic ("Show").
# Used to verify the X-Hub-Signature-256 header on every webhook POST.
META_APP_SECRET=

# Any long random string YOU invent. Paste the exact same value into the
# Meta webhook configuration as the "Verify token".
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-string

# The private reply that is sent to commenters who match a keyword.
# Include your link here. {username} = e.g. @alice, {keyword} = matched word.
DM_MESSAGE=Hey {username}! Thanks for commenting. Here is the link you asked for: https://example.com/your-resource

# Follower-only gate. Keep this true in production: the app sends only when
# Meta's profile API returns is_user_follow_business=true. If Meta reports
# false or cannot verify the status, it sends nothing. Set false only for
# local dry-run pipeline tests.
REQUIRE_FOLLOW_TO_SEND=true

# ---------------------------------------------------------------------------
# Matching
# ---------------------------------------------------------------------------

# Comma-separated, case-insensitive, whole-word matching. Put your keyword
# first, then common typos/variants. CHANGE THIS to your own words.
COMMENT_KEYWORDS=link,links,lnik,likn,lnk,liink,linkk

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Your Instagram professional account id. If set, webhook events for any
# other account are ignored. The id is in the webhook entry.id and in the
# API setup page next to your account.
IG_ACCOUNT_ID=

# Pin the Graph API version. Check Meta's changelog before changing.
META_GRAPH_VERSION=v25.0

# true = match and record comments but do NOT call Instagram (local testing).
# Must be false in production for real DMs.
DRY_RUN=true

# Durable storage for processed comment ids. REQUIRED on serverless hosts
# such as Vercel (the local file store does not persist there). Any Postgres
# connection string works (Neon, Supabase, Vercel Postgres, Railway...).
DATABASE_URL=

# Local file store location (used only when DATABASE_URL is empty).
DATA_FILE=./data/comments.json

# Optional Basic Auth for the dashboard page (recommended in production —
# the page shows commenter usernames and comment text).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

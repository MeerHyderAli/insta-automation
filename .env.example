# ---------------------------------------------------------------------------
# Server configuration (Node/Express). Copy to `.env` at the repository root.
# NEVER commit the real file. Every value below is validated by
# server/src/config/env.ts; see docs/SETUP.md for how to obtain each one.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Public origin of the browser app (CORS allowlist + OAuth return redirects).
CLIENT_ORIGIN=http://localhost:5173
# Additional allowed browser origins, comma-separated (optional).
CORS_ORIGINS=

# Public origin of this API. Used to build tracked resource links and the
# data-deletion status URL. Must be the externally reachable HTTPS origin in
# production, because Meta calls the webhook and OAuth callback.
API_PUBLIC_URL=http://localhost:3001

# ------------------------------- Database ----------------------------------
# Direct Postgres connection string (Supabase Session/Statement pooler).
# Required by the API and by `npm run db:migrate`.
DATABASE_URL=
# Set true when the connection requires TLS (Supabase requires it).
DATABASE_SSL=false

# ------------------------------- Supabase ----------------------------------
# Project URL + anon key are safe in the browser build.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Used for administrative Supabase work if enabled; never expose.
SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy JWT secret. When set, access tokens are verified locally
# (HS256) instead of via the project's JWKS endpoint.
SUPABASE_JWT_SECRET=

# --------------------------- Meta / Instagram ------------------------------
# Meta app of type "Business" with the Instagram product and
# "API setup with Instagram login".
META_APP_ID=
META_APP_SECRET=
# Must exactly match the Redirect URL configured on the Meta app, including
# the path below (no trailing slash).
META_REDIRECT_URI=http://localhost:3001/api/integrations/instagram/callback
# Long random string you also paste into the Meta webhook configuration.
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-string
# Pin the Graph API version; check the changelog before changing.
META_GRAPH_VERSION=v25.0
# Keep the comment scopes minimal. Add instagram_business_manage_messages to
# enable private replies; without it, private replies fail with a permission
# error while public replies still work. Post-DM follow checks also need it.
META_SCOPES=instagram_business_basic,instagram_business_manage_comments
META_WEBHOOK_FIELDS=comments

# 32 random bytes, base64 encoded: `openssl rand -base64 32`.
# Encrypts Instagram tokens at rest (AES-256-GCM). Changing it makes existing
# tokens undecryptable, so rotate with a planned reconnect.
TOKEN_ENCRYPTION_KEY=
TOKEN_KEY_VERSION=1
OAUTH_STATE_TTL_SECONDS=600

# ------------------------------- Worker ------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=1000
WORKER_MAX_ATTEMPTS=5
# Local safety budget below Meta's 750/hour limit.
PRIVATE_REPLIES_PER_HOUR=700

# ---------------------------- Feature flags --------------------------------
# Follow verification is NOT supported by Meta for arbitrary commenters.
# The server refuses to start if this is true; it exists only to document the
# capability gap.
FOLLOW_VERIFICATION_ENABLED=false
# AI drafting is not implemented; predefined templates are the fallback.
AI_SUGGESTIONS_ENABLED=false

# ---------------------------- Rate limits ----------------------------------
AUTH_RATE_LIMIT_PER_MINUTE=30
WEBHOOK_RATE_LIMIT_PER_MINUTE=600
MUTATION_RATE_LIMIT_PER_MINUTE=120

# ------------------------------- Demo mode ---------------------------------
# Local demo auth identity for screenshots. Requests still hit the real
# database, so seed data yourself. Refused when NODE_ENV=production.
DEMO_MODE=false
